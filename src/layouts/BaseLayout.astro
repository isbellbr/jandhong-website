---
import "../styles/global.css";
import SEO from "../components/SEO.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyCallButton from "../components/StickyCallButton.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Set true to add top padding (use when page does not have a full-bleed dark hero) */
  padTop?: boolean;
}

const { title, description, image, noindex, padTop = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <SEO title={title} description={description} image={image} noindex={noindex} />
  </head>
  <body class="min-h-screen overflow-x-hidden">
    <a
      href="#main"
      class="absolute -top-12 left-4 z-[100] rounded-full bg-white px-4 py-2 text-sm font-semibold text-[color:var(--color-ink)] shadow focus:top-4"
    >
      Skip to content
    </a>

    <Header />

    <main id="main" class={padTop ? "pt-28 md:pt-32" : ""}>
      <slot />
    </main>

    <Footer />
    <StickyCallButton />

    <script>
      // Reveal-on-scroll utility (zero-dep, respects prefers-reduced-motion)
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const targets = document.querySelectorAll<HTMLElement>(".reveal");
      if (reduce) {
        targets.forEach((el) => el.classList.add("is-visible"));
      } else if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.05 },
        );
        targets.forEach((el) => io.observe(el));
      } else {
        targets.forEach((el) => el.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
