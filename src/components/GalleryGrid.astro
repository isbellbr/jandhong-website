---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Project {
  title: string;
  caption: string;
  category: string;
  photo: ImageMetadata;
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<div
  class="grid auto-rows-[260px] gap-4 sm:grid-cols-2 sm:gap-5 md:auto-rows-[300px] lg:grid-cols-3 lg:gap-6"
  data-gallery
>
  {
    projects.map((p, i) => {
      // Vary card spans for visual rhythm
      const spans = ["sm:col-span-2 sm:row-span-2", "", "", "lg:row-span-2", "sm:col-span-2", ""];
      const span = spans[i % spans.length];
      return (
        <button
          type="button"
          class={`group relative overflow-hidden rounded-2xl text-left ${span}`}
          data-gallery-item
          data-src={p.photo.src}
          data-srcset={p.photo.src}
          data-title={p.title}
          data-caption={p.caption}
          data-category={p.category}
          aria-label={`View larger: ${p.title}`}
        >
          <Image
            src={p.photo}
            alt={p.title}
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
            widths={[600, 1000, 1600]}
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
          />
          <div
            class="absolute inset-x-0 bottom-0 flex flex-col gap-1 p-5 text-white opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100"
            style="background: linear-gradient(180deg, rgba(15,27,45,0) 0%, rgba(15,27,45,0.85) 100%);"
          >
            <span class="text-xs font-semibold tracking-[0.16em] uppercase opacity-90">
              {p.category}
            </span>
            <span class="font-serif text-lg">{p.title}</span>
          </div>
        </button>
      );
    })
  }
</div>

<!-- Lightbox -->
<dialog
  id="gallery-lightbox"
  class="m-0 max-w-none bg-transparent p-0 backdrop:bg-[color:var(--color-ink)]/85 backdrop:backdrop-blur-sm"
  aria-label="Project photo"
>
  <div class="fixed inset-0 flex flex-col">
    <button
      type="button"
      class="absolute top-4 right-4 z-10 inline-flex h-11 w-11 items-center justify-center rounded-full bg-white/15 text-white backdrop-blur transition-colors hover:bg-white/25"
      data-close
      aria-label="Close"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <button
      type="button"
      class="absolute top-1/2 left-3 z-10 inline-flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/15 text-white backdrop-blur transition-colors hover:bg-white/25 md:left-6"
      data-prev
      aria-label="Previous photo"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <button
      type="button"
      class="absolute top-1/2 right-3 z-10 inline-flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/15 text-white backdrop-blur transition-colors hover:bg-white/25 md:right-6"
      data-next
      aria-label="Next photo"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="9 6 15 12 9 18"></polyline>
      </svg>
    </button>

    <div class="flex flex-1 items-center justify-center p-4 md:p-10">
      <img
        data-lightbox-img
        src=""
        alt=""
        class="max-h-[80vh] max-w-full rounded-xl object-contain shadow-2xl"
      />
    </div>

    <div class="px-6 pb-8 text-center text-white">
      <p class="text-xs tracking-[0.18em] uppercase opacity-70" data-lightbox-category></p>
      <h3 class="font-serif text-2xl md:text-3xl" data-lightbox-title></h3>
      <p class="mx-auto mt-2 max-w-xl text-sm opacity-80" data-lightbox-caption></p>
    </div>
  </div>
</dialog>

<script>
  type Slide = { src: string; title: string; caption: string; category: string };

  const dialog = document.getElementById("gallery-lightbox") as HTMLDialogElement | null;
  if (dialog) {
    const items = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-gallery-item]"),
    );
    const slides: Slide[] = items.map((el) => ({
      src: el.dataset.src ?? "",
      title: el.dataset.title ?? "",
      caption: el.dataset.caption ?? "",
      category: el.dataset.category ?? "",
    }));
    const imgEl = dialog.querySelector<HTMLImageElement>("[data-lightbox-img]")!;
    const titleEl = dialog.querySelector<HTMLElement>("[data-lightbox-title]")!;
    const captionEl = dialog.querySelector<HTMLElement>("[data-lightbox-caption]")!;
    const categoryEl = dialog.querySelector<HTMLElement>("[data-lightbox-category]")!;

    let index = 0;
    const render = () => {
      const s = slides[index];
      imgEl.src = s.src;
      imgEl.alt = s.title;
      titleEl.textContent = s.title;
      captionEl.textContent = s.caption;
      categoryEl.textContent = s.category;
    };
    const open = (i: number) => {
      index = i;
      render();
      dialog.showModal();
      document.body.style.overflow = "hidden";
    };
    const close = () => {
      dialog.close();
      document.body.style.overflow = "";
    };
    const next = () => {
      index = (index + 1) % slides.length;
      render();
    };
    const prev = () => {
      index = (index - 1 + slides.length) % slides.length;
      render();
    };

    items.forEach((el, i) => el.addEventListener("click", () => open(i)));
    dialog.querySelector("[data-close]")?.addEventListener("click", close);
    dialog.querySelector("[data-next]")?.addEventListener("click", next);
    dialog.querySelector("[data-prev]")?.addEventListener("click", prev);
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) close();
    });
    document.addEventListener("keydown", (e) => {
      if (!dialog.open) return;
      if (e.key === "ArrowRight") next();
      if (e.key === "ArrowLeft") prev();
    });
    dialog.addEventListener("close", () => {
      document.body.style.overflow = "";
    });
  }
</script>
