---
import ServiceIcon from "./ServiceIcon.astro";

interface Props {
  title: string;
  summary: string;
  href: string;
  icon: "roof" | "siding" | "gutter" | "skylight" | "window";
  number: string;
}
const { title, summary, href, icon, number } = Astro.props;
---

<a
  href={href}
  class="group relative flex h-full flex-col justify-between overflow-hidden rounded-2xl border p-7 transition-all duration-300 hover:-translate-y-1"
  style="background-color: white; border-color: var(--color-line); box-shadow: var(--shadow-soft);"
>
  <div>
    <div class="flex items-start justify-between">
      <div
        class="flex h-12 w-12 items-center justify-center rounded-xl transition-colors duration-300 group-hover:bg-[color:var(--color-ink)] group-hover:text-white"
        style="background-color: var(--color-paper-deep); color: var(--color-ink);"
      >
        <ServiceIcon name={icon} size={26} />
      </div>
      <span class="text-xs font-semibold tracking-[0.18em] opacity-50">{number}</span>
    </div>
    <h3 class="display-3 mt-6">{title}</h3>
    <p class="mt-3 text-sm leading-relaxed" style="color: var(--color-slate);">
      {summary}
    </p>
  </div>

  <span
    class="mt-7 inline-flex items-center gap-2 text-xs font-semibold tracking-[0.14em] uppercase transition-colors duration-300"
    style="color: var(--color-copper-deep);"
  >
    Learn more
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="transition-transform duration-300 group-hover:translate-x-1"
      aria-hidden="true"
    >
      <line x1="5" y1="12" x2="19" y2="12"></line>
      <polyline points="12 5 19 12 12 19"></polyline>
    </svg>
  </span>
</a>
